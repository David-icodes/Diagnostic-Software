# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local: mongodb://127.0.0.1:27017/diagnostic_lis
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/diagnostic_lis
MONGODB_URI=mongodb://127.0.0.1:27017/diagnostic_lis

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=diagnostic_token

# CORS — the Next.js frontend origin
FRONTEND_URL=http://localhost:3000

# Initial administrator (used by `npm run seed` only — never required at runtime)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrator

# WhatsApp Cloud API (Meta). Serve-only secrets — never expose to the frontend.
WHATSAPP_PHONE_NUMBER_ID=1333636249839249
WHATSAPP_WABA_ID=1118607157344335
# From the Meta app dashboard (System User access token / webhook Verify token / App secret)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0