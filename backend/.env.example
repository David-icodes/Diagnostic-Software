# ---------------------------------------------------------------------------
# Diagnostic LIS — backend environment variables
#
# Local development: copy this file to `.env` (gitignored).
# Production: set these in the Render dashboard (Environment → Environment
# Variables). Never commit real values.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
# Local fallback only — Render injects its own PORT at runtime.
PORT=5000

# MongoDB (required). The database name MUST be `diagnostic_lis`.
# Local:  mongodb://127.0.0.1:27017/diagnostic_lis
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/diagnostic_lis
MONGODB_URI=mongodb://127.0.0.1:27017/diagnostic_lis

# Authentication (required — JWT_SECRET must be at least 16 characters)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=diagnostic_token
# lax (default) | strict | none — use "none" when the frontend and API are on
# different sites (cross-site cookies require HTTPS, i.e. NODE_ENV=production).
COOKIE_SAMESITE=lax

# CORS — origins allowed to send credentialed browser requests.
# FRONTEND_URL is used when CORS_ORIGINS is empty.
FRONTEND_URL=http://localhost:3000
# Optional comma-separated allow-list (takes precedence over FRONTEND_URL).
# CORS_ORIGINS=https://your-frontend.example,http://localhost:3000,http://localhost:3001
CORS_ORIGINS=

# Initial administrator — used by `npm run seed` only, never required at runtime
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# WhatsApp Cloud API (Meta) — server-side only, never expose to the frontend
# WHATSAPP_WABA_ID is the WhatsApp Business Account ID.
# WHATSAPP_GRAPH_VERSION is the Graph API version used for outbound sending
# (you may know this as "WHATSAPP_API_VERSION").
WHATSAPP_PHONE_NUMBER_ID=1333636249839249
WHATSAPP_WABA_ID=1118607157344335
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# New LIS workflows only. Copy each exact language code from its Meta template.
# No default is provided; these never change the existing report_ready caller.
WHATSAPP_LAB_REPORT_READY_LANGUAGE=
WHATSAPP_LAB_INVOICE_READY_LANGUAGE=
WHATSAPP_PATIENT_THANK_YOU_LANGUAGE=
# Retained compatibility setting; the shared LIS WhatsApp workflow defaults local ten-digit numbers to +91.
WHATSAPP_LOCAL_COUNTRY_CODE=
# Must match the origin of frontend NEXT_PUBLIC_API_URL (without /api/v1).
WHATSAPP_RENDER_API_ORIGIN=http://localhost:5000
# PDF renderer setup on the backend host: npx playwright install --with-deps chromium

# Deployment build: npm ci && npm run build:deployment
# Linux hosts also need Chromium OS libraries: npx playwright install --with-deps chromium
# Install and run as the same service user; persist PLAYWRIGHT_BROWSERS_PATH if using a custom cache.
