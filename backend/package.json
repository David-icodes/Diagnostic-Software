  "name": "diagnostic-lis-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Diagnostic Centre / LIS API â€” Express + TypeScript + MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-report-assets.cjs",
