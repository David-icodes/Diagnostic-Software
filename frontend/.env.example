# Base URL of the backend API (must end with /api/v1).
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
#
# Production — set this in the frontend host's environment variables:
# NEXT_PUBLIC_API_URL=https://diagnostic-software.onrender.com/api/v1
#
# This value is inlined into the browser bundle, so never put secrets here.
